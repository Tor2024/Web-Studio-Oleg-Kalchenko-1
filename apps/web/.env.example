# Admin panel password (required to access /admin in production)
ADMIN_PASSWORD=change-me

# Cookie signing secret for admin auth (generate with: openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-long-random-hex-string

# GitHub fine-grained PAT for CMS storage (Contents: Read/Write for this repo)
# Create at: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Target GitHub repo for CMS data (owner/name)
GITHUB_REPO_OWNER=Tor2024
GITHUB_REPO_NAME=Web-Studio-Oleg-Kalchenko-1
GITHUB_REPO_BRANCH=main
