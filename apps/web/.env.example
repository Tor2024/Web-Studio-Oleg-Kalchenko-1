# Password that protects /admin. Set to any strong value.
ADMIN_PASSWORD=change-me

# Random value used to derive the admin session cookie (HMAC key).
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-64-hex-chars

# Fine-grained GitHub Personal Access Token with "Contents: Read and write"
# on the content repo. Required in production (Vercel) to persist admin edits.
# When unset, admin writes fall back to the local filesystem (dev only).
GITHUB_TOKEN=

# Optional overrides. The code defaults to the values below.
GITHUB_REPO_OWNER=Tor2024
GITHUB_REPO_NAME=Web-Studio-Oleg-Kalchenko-1
GITHUB_REPO_BRANCH=master
